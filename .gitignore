# Data-release boundary: raw data is NEVER committed (esp. DUA-gated n2c2).
data/raw/
data/processed/
# Generated run artifacts are transient; only the curated collection outputs below are tracked.
results/*
!results/DISCREPANCIES.md
!results/paper_data.json
!results/paper_data.md
!results/AUDIT.md
!results/audit.json
!results/selective_accuracy_corrected.json
!results/missing/
results/missing/*
!results/missing/AUDIT_missing.md
!results/missing/audit_missing.json
!results/missing/missing_runs.json
!results/missing/selective_accuracy_corrected.json
!results/missing/suspect_items.json
!results/missing/SUSPECT_ITEMS.md
*.pyc
__pycache__/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.criterialogic_cache/

# Secrets: never commit API keys.
.env

# Single-file bundle used to bootstrap the repo; source of truth is the tree itself.
CriteriaLogic_bundle.md
