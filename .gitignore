# Data-release boundary: raw data is NEVER committed (esp. DUA-gated n2c2).
data/raw/
!data/processed/
data/processed/*
!data/processed/logic_set_depth_sweep.json
!data/processed/logic_set_mixed.json
# Generated run artifacts are transient; only the curated collection outputs below are tracked.
results/*
!results/DISCREPANCIES.md
!results/paper_data.json
!results/paper_data.md
!results/agreement.json
!results/verify_extract.md
!results/AUDIT.md
!results/audit.json
!results/selective_accuracy_corrected.json
!results/compositional__openai.json
!results/real_criteria__openai.json
!results/compositional__rule_based.json
!results/compositional__negation_blind.json
!results/real_criteria__rule_based.json
!results/real_criteria__negation_blind.json
!results/mixed_v2/
results/mixed_v2/*
!results/mixed_v2/compositional__openai.json
!results/mixed_v2/report.md
!results/missing/
results/missing/*
!results/missing/AUDIT_missing.md
!results/missing/audit_missing.json
!results/missing/missing_runs.json
!results/missing/selective_accuracy_corrected.json
!results/missing/suspect_items.json
!results/missing/SUSPECT_ITEMS.md
*.pyc
__pycache__/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.criterialogic_cache/

# Secrets: never commit API keys or local env files.
.env
.env.*
!.env.example

# Manuscript stays local; do not publish the paper on GitHub.
paper/

# Local editor state. Tooling configuration is excluded via .git/info/exclude, which
# is not committed, so the public tree carries no local-tooling names at all.
.vscode/
.idea/
*.code-workspace

# Single-file bundle used to bootstrap the repo; source of truth is the tree itself.
CriteriaLogic_bundle.md

# Added in v0.2
# Held-back automatic labels stay local. The two finished label files and the
# agreement report are released; blank export sheets are not.
!annotation/
annotation/*
!annotation/automatic_labels_HELD_BACK.csv
!annotation/annotator1_labels.csv
!annotation/annotator2_labels.csv
!annotation/report.json
# partial submissions
results/leaderboard/*.tmp
